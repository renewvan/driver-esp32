# Secrets are per board. Copy this file twice (both gitignored):
#
#   secrets.yaml          what every board of the van shares: wifi_ssid, wifi_password,
#                         wifi_ap_fallback_password, mqtt_broker, mqtt_port
#   secrets/<board>.yaml  what is the board's own: mqtt_username (`esp32-<board>`, its broker
#                         account) and mqtt_password, ota_password, api_encryption_key, and
#                         optionally ota_address
#
# `scripts/flash.sh <variant> --board <board>` lays secrets/<board>.yaml over secrets.yaml (keys in
# the board's file win), so a board never builds with another board's credentials. Keep every
# key in one file or the other; this example lists them all so CI can validate the config.
# Flat `key: value` lines only.

# Optional, board file only: where to OTA this board when `--device` is not given. Without it
# esphome finds the board by its hostname, renewvan-esp32-<board>. Not an ESPHome secret.
# ota_address: "192.168.1.51"

wifi_ssid: "your-van-wifi"
wifi_password: "your-van-wifi-password"
# Fallback AP password if the van WiFi is unreachable at boot.
wifi_ap_fallback_password: "changeme12345"

# esphome run/logs use OTA; pick your own password.
ota_password: "changeme12345"

# Placeholder for CI validation only — generate your own real key with:
# esphome secrets api_encryption_key (or: openssl rand -base64 32).
api_encryption_key: "eKYdEeFndWqLBBPSwPbkOjx+faIh3s3KCrRzRyxBIuM="

# BLE wake (esp32-16x-relay): the shared secret a phone must send to power the hub on over
# Bluetooth. Board file. Placeholder for CI; generate your own: openssl rand -hex 12
ble_wake_secret: "changeme-ble-wake"

# Van bus — same Mosquitto broker every other renewvan device publishes to. Each board has its
# own broker account named by its Driver key, `esp32-<board>` (hub ADR 0027): the password is the
# hub's MQTT_ESP32_<BOARD>_PASSWORD, and the account may write only that board's topics.
mqtt_broker: "192.168.1.10"
mqtt_port: 1883
mqtt_username: ""
mqtt_password: ""
