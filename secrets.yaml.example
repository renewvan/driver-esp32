# One file per board. Copy this file to secrets/<board>.yaml (gitignored) and fill in EVERY key:
#
#   mkdir -p secrets && cp secrets.yaml.example secrets/<board>.yaml
#
# `<board>` is the name you pass to `scripts/flash.sh <variant> --board <board>`. flash.sh builds
# from that one file only, so a board never builds with another board's credentials. There is no
# shared file: two boards on the same WiFi repeat the WiFi lines. Flat `key: value` lines only.
#
# (CI copies this file to secrets.yaml to validate the config with these placeholders; you never
# need a root secrets.yaml to flash.)

# --- WiFi -----------------------------------------------------------------------------------
wifi_ssid: "your-van-wifi"
wifi_password: "your-van-wifi-password"
# Password of the recovery access point the board opens if the van WiFi is unreachable at boot.
wifi_ap_fallback_password: "changeme12345"

# --- Van bus --------------------------------------------------------------------------------
# The same Mosquitto broker every other renewvan device publishes to. Each board has its own broker
# account named by its Driver key, `esp32-<board>` (hub ADR 0027): the password is the hub's
# MQTT_ESP32_<BOARD>_PASSWORD, and the account may write only that board's topics.
mqtt_broker: "192.168.1.10"
mqtt_port: 1883
mqtt_username: ""
mqtt_password: ""

# --- Updates --------------------------------------------------------------------------------
# esphome run/logs use OTA; pick your own password.
ota_password: "changeme12345"
# Optional: where to OTA this board when `--device` is not given. Without it esphome finds the
# board by its hostname, renewvan-esp32-<board>. Not an ESPHome secret.
# ota_address: "192.168.1.51"

# --- BLE wake (esp32-16x-relay only) --------------------------------------------------------
# What a phone must send to power the hub on over Bluetooth. Generate your own: openssl rand -hex 12
ble_wake_secret: "changeme-ble-wake"
