# Copy to secrets.yaml (gitignored) and fill in your own values before
# running `scripts/flash.sh <variant>` (e.g. esp32-16x-relay). ESPHome reads it through
# the firmware/secrets.yaml symlink, shared by every variant.

wifi_ssid: "your-van-wifi"
wifi_password: "your-van-wifi-password"
# Fallback AP password if the van WiFi is unreachable at boot.
wifi_ap_fallback_password: "changeme12345"

# esphome run/logs use OTA; pick your own password.
ota_password: "changeme12345"

# Placeholder for CI validation only — generate your own real key with:
# esphome secrets api_encryption_key (or: openssl rand -base64 32).
api_encryption_key: "eKYdEeFndWqLBBPSwPbkOjx+faIh3s3KCrRzRyxBIuM="

# Van bus — same Mosquitto broker every other renewvan device publishes
# to (this compose's RENEWVAN_HOST/PORT/USERNAME/PASSWORD).
mqtt_broker: "192.168.1.10"
mqtt_port: 1883
mqtt_username: ""
mqtt_password: ""
